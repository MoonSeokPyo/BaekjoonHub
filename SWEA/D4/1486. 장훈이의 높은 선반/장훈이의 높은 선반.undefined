import java.util.*;
import java.io.*;

class Solution {
	static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
	static BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
	public static void main (String[] args) throws Exception {
		func_1486();
		
		br.close();
		bw.close();
	}
	
	static void func_1486() throws Exception {
		Context_1486 ct = new Context_1486();
		StringBuilder sb = new StringBuilder();
		int T = Integer.parseInt(br.readLine());
		for (int tc = 1; tc <= T; tc++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			int N = Integer.parseInt(st.nextToken());		ct.N = N;
			int B = Integer.parseInt(st.nextToken());		ct.B = B;
			int[] h = new int[N];							ct.h = h;
			st = new StringTokenizer(br.readLine());
			for (int i = 0; i < N; i++) {
				h[i] = Integer.parseInt(st.nextToken());
			}
			ct.min = Integer.MAX_VALUE;
			func_1486_min(ct, 0, 0);
			sb.append('#').append(tc).append(' ').append(ct.min - B).append('\n');
		}
		bw.write(sb.toString());
	}
	static void func_1486_min(Context_1486 ct, int sum, int idx) {
		int N = ct.N, B = ct.B;
		int[] h = ct.h;
		if (sum >= B) {
			if (sum < ct.min)
				ct.min = sum;
			return;
		}
		if (idx == N)
			return;
		func_1486_min(ct, sum + h[idx], idx + 1);
		func_1486_min(ct, sum, idx + 1);
	}
	static class Context_1486 {
		int N, B;
		int[] h;
		int min;
	}
}